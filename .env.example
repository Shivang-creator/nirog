# Copy to .env.local and fill in.  cp .env.example .env.local
# .env.local is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# CockroachDB — the only variable required to run.
# ---------------------------------------------------------------------------
# Cloud Console → your cluster → Connect → Connection string.
# Includes the password; it is shown once when the SQL user is created.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# ---------------------------------------------------------------------------
# AWS Bedrock — optional.
# ---------------------------------------------------------------------------
# Leave these blank and the app falls back to a deterministic offline embedder.
# Everything still builds, seeds, runs and passes its tests; the difference is
# recorded honestly in complaint.embed_model and recall_event.embed_provider.
#
# The model must be enabled for your account in this region, and the account
# must be on a paid plan — the AWS free plan blocks Bedrock inference entirely
# and returns "ValidationException: Operation not allowed" for every model.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The embedding model. There is deliberately no generative model in the
# clinical output — see "Why there is no LLM in the clinical output" in the
# README; the chat model below conducts the conversation, never the chart.
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ---------------------------------------------------------------------------
# ARIA's conversational model — optional.
# ---------------------------------------------------------------------------
# The intake conversation and SBAR handover, served by this app's own
# /api/aria/* routes on Amazon Bedrock with the same AWS credentials as above
# (the IAM policy must allow bedrock:InvokeModel on this model too). Point
# NEXT_PUBLIC_ARIA_API_URL elsewhere to use an external ARIA backend instead;
# leave it unset and ARIA replies with her offline line.
#BEDROCK_CHAT_MODEL=openai.gpt-oss-120b-1:0
#NEXT_PUBLIC_ARIA_API_URL=/api/aria

# ---------------------------------------------------------------------------
# Amazon Polly (ARIA's voice) — optional.
# ---------------------------------------------------------------------------
# Uses the same AWS credentials as Bedrock above. Without them /api/speak
# answers 501 and the app falls back to the browser's speech synthesis.
#POLLY_VOICE_ID=Kajal
#POLLY_ENGINE=neural

# ---------------------------------------------------------------------------
# Doctor portal data source — optional.
# ---------------------------------------------------------------------------
# mock (default) | db (Prisma) | supabase. The portal ships with a complete
# in-memory source, so leaving this unset always works. `db` requires the
# Prisma schema (prisma/schema.prisma) pushed to the database DATABASE_URL
# points at, plus DIRECT_URL for migrations; `supabase` requires the Supabase
# variables below.
#NIROG_DATA_SOURCE=mock
#DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase auth (doctor/pharmacy sign-in) — optional.
# ---------------------------------------------------------------------------
# All three unset = demo sign-in: any email and password reach the portal,
# backed entirely by mock data. Set all three to turn on real accounts, MFA
# and OAuth. The service-role key is server-only — never expose it.
#NEXT_PUBLIC_SUPABASE_URL=
#NEXT_PUBLIC_SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Video consultation — optional.
# ---------------------------------------------------------------------------
# Signalling needs nothing: the offer, answer and ICE candidates go through
# CockroachDB (see call_signal in schema.sql), so a call works with DATABASE_URL
# alone wherever the two peers can find a direct path.
#
# TURN is what carries a call across carrier-grade NAT and restrictive mobile
# networks, which is the normal case for the patients this is built for. Either
# give the Metered API key AND the app subdomain from the dashboard, or paste
# static credentials. Both are read server-side and never reach the browser.
#METERED_API_KEY=
#METERED_APP_NAME=your-app        # the <name> in https://<name>.metered.live
# …or, instead of the two above:
#TURN_URLS=turn:example.metered.live:80,turn:example.metered.live:443
#TURN_USERNAME=
#TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# How many synthetic patients `npm run db:volume` generates.
VOLUME_PATIENTS=400

# Base URL used by the Playwright checks (check:browser / walk).
#BASE_URL=http://localhost:3111
